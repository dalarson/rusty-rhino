# Supabase Postgres (Project Settings > Database > Connection string > JDBC, use the pooler)
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?prepareThreshold=0
DB_USER=postgres.<project-ref>
DB_PASSWORD=

# Supabase Storage (Project Settings > API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=

# Admin credentials (optional for local dev)
ADMIN_USER_1=
ADMIN_PASS_1=
