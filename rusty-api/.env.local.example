# Copy to rusty-api/.env.local (gitignored) and fill in. Loaded by ./dev.sh.

# --- Database (required) ---
# Supabase pooler or local Postgres
DB_URL=jdbc:postgresql://<host>:<port>/postgres
DB_USER=
DB_PASSWORD=

# --- Supabase storage for image uploads (required) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Admin login (optional; up to 3 users) ---
ADMIN_USER_1=
ADMIN_PASS_1=
# ADMIN_USER_2=
# ADMIN_PASS_2=
# ADMIN_USER_3=
# ADMIN_PASS_3=

# --- Optional overrides ---
# JWT_SECRET=
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Inquiry notification email (SMTP) ---
# Leave MAIL_HOST empty to skip sending. For Gmail, use an app password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Defaults to MAIL_USERNAME
# INQUIRY_NOTIFY_FROM=
# Defaults to annmarielarson3@yahoo.com; set to your own address when testing
# INQUIRY_NOTIFY_TO=
# Used for the listing link in the email
SITE_URL=http://localhost:5173
